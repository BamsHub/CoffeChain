# ================================================================
# COFFEECHAIN ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ================================================================
# Salin file ini menjadi .env.local untuk penggunaan lokal di komputer Anda.
# Untuk Vercel: Masukkan key-value ini di menu: Project Settings > Environment Variables

# --- 1. SUPABASE (Database Utama) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- 2. PINATA IPFS (Penyimpanan Off-Chain & Desentralisasi) ---
PINATA_API_KEY=your-pinata-api-key
PINATA_API_SECRET=your-pinata-secret-api-key
# JWT dapat dipakai sebagai pengganti pasangan API key/secret.
PINATA_JWT=your-pinata-jwt
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# --- 3. SOLANA BLOCKCHAIN (Pencatatan Memo On-Chain) ---
# Private key array JSON 64 byte untuk wallet sistem pencatat
MEMO_SIGNER_SECRET_KEY=
# Public key harus merupakan pasangan dari secret key di atas
MEMO_SIGNER_PUBLIC_KEY=8erURhHZgSvoFeXAJSDWzk2JDEiLsWeKq11zpiPs7AhJ
NEXT_PUBLIC_MEMO_SIGNER_PUBLIC_KEY=8erURhHZgSvoFeXAJSDWzk2JDEiLsWeKq11zpiPs7AhJ
# Opsional: RPC privat/reliable. Default memakai https://api.testnet.solana.com
SOLANA_RPC_URL=https://api.testnet.solana.com

# --- 4. MIDTRANS PAYMENT GATEWAY ---
MIDTRANS_SERVER_KEY=your-midtrans-server-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com/v2
MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com/snap/v1
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# --- 5. AUTH & SECURITY ---
JWT_SECRET=your-super-secret-jwt-key
NEXT_PUBLIC_APP_URL=http://localhost:3002

# --- 6. EMAIL SERVICE (Opsional - Resend / Gmail) ---
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM="CoffeeChain <no-reply@coffeechain.io>"
